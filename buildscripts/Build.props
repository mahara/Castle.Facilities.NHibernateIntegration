<Project>

  <!--
    https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-your-build
    https://learn.microsoft.com/en-us/visualstudio/msbuild/common-msbuild-project-properties
    https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-reserved-and-well-known-properties
    https://learn.microsoft.com/en-us/cpp/build/reference/common-macros-for-build-commands-and-properties
    https://learn.microsoft.com/en-us/dotnet/core/project-sdk/msbuild-props
    https://learn.microsoft.com/en-us/dotnet/standard/frameworks
    https://learn.microsoft.com/en-us/visualstudio/msbuild/property-functions
    https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-conditions
    https://learn.microsoft.com/en-us/dotnet/standard/library-guidance/nuget
    https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices
    https://github.com/castleproject/Core/pull/616
  -->

  <!--
    PROPERTIES
  -->

  <PropertyGroup>
    <WinExeTargetFrameworks Condition="'$(WinExeTargetFrameworks)' == ''">net472</WinExeTargetFrameworks>
    <WinTestTargetFrameworks Condition="'$(WinTestTargetFrameworks)' == ''">net472</WinTestTargetFrameworks>
    <WinLibTargetFrameworks Condition="'$(WinLibTargetFrameworks)' == ''">net472</WinLibTargetFrameworks>
    <ExeTargetFrameworks Condition="'$(ExeTargetFrameworks)' == ''">net472</ExeTargetFrameworks>
    <TestTargetFrameworks Condition="'$(TestTargetFrameworks)' == ''">net472</TestTargetFrameworks>
    <LibTargetFrameworks Condition="'$(LibTargetFrameworks)' == ''">net472</LibTargetFrameworks>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <PackageOutputPath>..\..\build\</PackageOutputPath>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>

    <BuildVersion Condition="'$(BuildVersion)' == ''">0.0.0</BuildVersion>
    <BuildVersion Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</BuildVersion>
    <BuildVersion>$([System.Text.RegularExpressions.Regex]::Replace($(BuildVersion), '^v', ''))</BuildVersion>
    <BuildVersionPrefix>$(BuildVersion.Split('-')[0])</BuildVersionPrefix>
    <BuildVersionPrefixMajor>$(BuildVersionPrefix.Split('.')[0])</BuildVersionPrefixMajor>

    <AssemblyOriginatorKeyFileName>CastleKey.snk</AssemblyOriginatorKeyFileName>
    <AssemblyOriginatorKeyFile>..\..\buildscripts\$(AssemblyOriginatorKeyFileName)</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    https://learn.microsoft.com/en-us/dotnet/standard/library-guidance/nuget
  -->
  <PropertyGroup>
    <Product Condition="'$(Product)' == ''">Castle.Facilities.NHibernateIntegration</Product>
    <Title Condition="'$(Title)' == ''">$(Product)</Title>
    <Description Condition="'$(Description)' == ''">$(Product)</Description>
    <Authors Condition="'$(Authors)' == ''">Castle Project Contributors</Authors>
    <Company Condition="'$(Company)' == ''">Castle Project</Company>
    <CurrentYear Condition="'$(CurrentYear)' == ''">$([System.DateTime]::Now.ToString("yyyy"))</CurrentYear>
    <Copyright Condition="'$(Copyright)' == ''">Copyright (c) 2004-$(CurrentYear) Castle Project - https://www.castleproject.org/</Copyright>

    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersionPrefixMajor).0.0.0</AssemblyVersion>
    <FileVersion>$(BuildVersionPrefix).0</FileVersion>

    <PackageVersion>$(BuildVersion)</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseUrl Condition="'$(PackageLicenseUrl)' == ''">http://www.apache.org/licenses/LICENSE-2.0.html</PackageLicenseUrl>
    <PackageRequireLicenseAcceptance Condition="'$(PackageRequireLicenseAcceptance)' == ''">false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/mahara/Castle.Facilities.NHibernateIntegration</PackageProjectUrl>
    <PackageIcon Condition="'$(PackageIcon)' == ''">castle_facilities_nhibernateintegration-logo.png</PackageIcon>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/mahara/Castle.Facilities.NHibernateIntegration</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <ContentTargetFolders>.</ContentTargetFolders>
  </PropertyGroup>

  <PropertyGroup>
    <BaseConstants></BaseConstants>

    <NetFrameworkConstants>$(BaseConstants)</NetFrameworkConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net472'))">
    <DefineConstants>$(NetFrameworkConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\buildscripts\AssemblyInfo.Global.cs" Link="Properties\AssemblyInfo.Global.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="Properties\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Link="Properties\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Link="Properties\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\readme.txt" Link="Properties\readme.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\ASL - Apache Software Foundation License.txt" Link="Properties\ASL - Apache Software Foundation License.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\castle_facilities_nhibernateintegration-logo.png" Link="Properties\castle_facilities_nhibernateintegration-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
